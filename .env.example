# =============================================================================
# Šablona proměnných – BEZ HODNOT. Zkopíruj do .env.local a doplň klíče.
# =============================================================================
#
# BEZPEČNOST:
#   ✅ .env.local  → lokální vývoj (v .gitignore, NIKDY do GitHubu)
#   ✅ Vercel      → produkce (Settings → Environment Variables)
#   ❌ Nikdy necommituj .env.local
#   ❌ Nikdy neposílej secret klíče do chatu / e-mailu
#
# PREFIX NEXT_PUBLIC_ = viditelné v prohlížeči (jen veřejné klíče!)
# Bez prefixu           = pouze na serveru (API routes, lib/)
# =============================================================================

# --- Supabase (veřejné klíče OK v NEXT_PUBLIC_) ---
NEXT_PUBLIC_SUPABASE_URL=https://XXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# TAJNÉ – jen server (webhook Stripe):
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (TAJNÉ – jen server) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Fakturoid OAuth (TAJNÉ – jen server, integrace Audeflow) ---
# Vytvoř v Fakturoidu: Nastavení → Propojit jiné aplikace → OAuth 2 pro vývojáře
# Redirect URL: https://faktury.audeflow.cz/api/accounting/fakturoid/callback
FAKTUROID_CLIENT_ID=
FAKTUROID_CLIENT_SECRET=

# --- Stripe ---
# Lokálně používej TEST klíče (pk_test_..., sk_test_...)
# https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Webhook: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID z Products → Starter (299 Kč/měs) a Pro (599 Kč/měs)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# --- Resend (TAJNÉ – jen server, volitelné) ---
RESEND_API_KEY=
FROM_EMAIL=faktury@audeflow.cz

# --- App ---
# Lokálně: http://localhost:3000
# Produkce: https://faktury.audeflow.cz
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Vercel (volitelné, CLI deploy) ---
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
