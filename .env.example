# Supabase — Project URL (Settings → API → Project URL), NE REST URL (/rest/v1)!
NEXT_PUBLIC_SUPABASE_URL=https://XXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Stripe — viz scripts/stripe-setup.mjs pro vytvoření cen
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_... nebo pk_test_...
STRIPE_SECRET_KEY=sk_live_... nebo sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...       # Standard 299 Kč jednorázově — 100 faktur (kredit)
STRIPE_PRICE_PRO=price_...             # Pro 899 Kč/měs — neomezeně faktur
STRIPE_PRICE_MULTI_CLIENT=price_...    # Modul více klientů +299 Kč/měs (doplňek)
# STRIPE_PRICE_ACCOUNTANT=price_...    # zastaralé alias — lze nechat pro zpětnou kompatibilitu

# Resend (inbound faktury + volitelné notifikace u nových faktur)
RESEND_API_KEY=
# Signing secret z Resend → Webhooks → detail webhooku (whsec_...)
RESEND_WEBHOOK_SECRET=
# RESEND_FROM_EMAIL=Faktury Audeflow <faktury@audeflow.cz>

# Volitelný fallback pro jiné inbound providery (Resend používá RESEND_WEBHOOK_SECRET)
# INBOUND_EMAIL_WEBHOOK_SECRET=
# INBOUND_EMAIL_DOMAIN=in.audeflow.cz

# App
NEXT_PUBLIC_APP_URL=https://faktury.audeflow.cz
# Hook video na landingu (volitelný override; výchozí je /videos/demo.mov)
# NEXT_PUBLIC_LANDING_DEMO_VIDEO_URL=/videos/demo.mp4
# Volitelně po ověření v Google Search Console:
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
